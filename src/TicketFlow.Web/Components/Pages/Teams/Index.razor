@page "/teams"
@using MudBlazor
@using TicketFlow.Shared.DTOs
@using TicketFlow.Web.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Teams — Desk</PageTitle>

<div class="page-header">
    <div><h1>@(AuthService.IsManager ? "Teams" : "My Teams")</h1><p>@_totalCount teams</p></div>
    @if (AuthService.IsManager)
    {
        <div style="display:flex; gap:8px;">
            <button class="btn btn-primary" @onclick="() => _showAdd = true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                New team
            </button>
        </div>
    }
</div>

<div class="filter-bar">
    <input class="search-input" type="text" placeholder="Search teams…"
           value="@_search" @oninput="OnSearchInput" />
</div>

<div class="card" style="overflow:hidden;">
    <MudDataGrid @ref="_grid" T="TeamDto" ServerData="ServerReload" Loading="_loading"
                 Hover="true" Dense="true" RowsPerPage="15" Height="calc(79vh - 260px)" FixedHeader="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.OwnerName" Title="Owner">
                <CellTemplate>
                    <span class="text-2">@context.Item.OwnerName</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.MemberCount" Title="Members">
                <CellTemplate>
                    <span class="text-2 mono">@context.Item.MemberCount</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.ProjectCount" Title="Projects">
                <CellTemplate>
                    <span class="text-2 mono">@context.Item.ProjectCount</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Id" Title="">
                <CellTemplate>
                    <div style="text-align:right;">
                        <a href="/teams/@context.Item.Id" class="btn btn-ghost btn-sm">@(AuthService.IsManager ? "Manage" : "View")</a>
                        @if (AuthService.IsManager)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="() => Delete(context.Item)">Delete</button>
                        }
                    </div>
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <NoRecordsContent>
            <div class="empty-state">
                <p>No teams match your search.</p>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="TeamDto" />
        </PagerContent>
    </MudDataGrid>
</div>

@if (_showAdd)
{
    <div class="dialog-overlay" @onclick="() => _showAdd = false">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <div class="dialog-title">New team</div>
            <div class="field">
                <label>Name</label>
                <input class="input" type="text" @bind="_newName" placeholder="e.g. Backend Team" />
            </div>
            <div class="field">
                <label>Description</label>
                <input class="input" type="text" @bind="_newDescription" placeholder="Optional" />
            </div>
            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="() => _showAdd = false">Cancel</button>
                <button class="btn btn-primary" @onclick="Add" disabled="@_busy">Add</button>
            </div>
        </div>
    </div>
}

@code {
    private MudDataGrid<TeamDto> _grid = default!;
    private bool _loading = true, _showAdd, _busy;
    private string _newName = "", _newDescription = "";
    private string _search = "";
    private int _totalCount;
    private CancellationTokenSource? _debounceCts;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _ = DebounceReload(token);
    }

    private async Task DebounceReload(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            _grid.NavigateTo(Page.First);
        }
        catch (TaskCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/"); return; }
        await _grid.ReloadServerData();
    }

    private async Task<GridData<TeamDto>> ServerReload(GridState<TeamDto> state)
    {
        var result = AuthService.IsManager
            ? await ApiService.GetTeamsPagedAsync(state.Page + 1, state.PageSize, _search)
            : AuthService.IsAgent
                ? await ApiService.GetTeamsPagedAsync(state.Page + 1, state.PageSize, _search, forAgentId: AuthService.AgentId)
                : await ApiService.GetTeamsPagedAsync(state.Page + 1, state.PageSize, _search, forUserId: AuthService.UserId);

        _loading = false;
        _totalCount = result?.TotalCount ?? 0;
        return new GridData<TeamDto> { TotalItems = result?.TotalCount ?? 0, Items = result?.Items ?? [] };
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_newName)) { Snackbar.Add("Name is required.", Severity.Warning); return; }
        if (AuthService.UserId is null) { Snackbar.Add("Your account has no linked user profile. Please log out and back in.", Severity.Error); return; }
        _busy = true;

        var dto = new CreateTeamDto
        {
            Name = _newName,
            Description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription,
            OwnerUserId = AuthService.UserId.Value
        };

        var r = await ApiService.CreateTeamAsync(dto);
        _busy = false;

        if (r is not null)
        {
            _showAdd = false;
            _newName = ""; _newDescription = "";
            Snackbar.Add("Team created.", Severity.Success);
            await _grid.ReloadServerData();
        }
        else
        {
            Snackbar.Add("Failed to create team.", Severity.Error);
        }
    }

    private async Task Delete(TeamDto t)
    {
        if (AuthService.UserId is null) return;
        var ok = await ApiService.DeleteTeamAsync(t.Id, AuthService.UserId.Value);
        if (ok) { Snackbar.Add("Team deleted.", Severity.Success); await _grid.ReloadServerData(); }
        else Snackbar.Add("Failed to delete team.", Severity.Error);
    }
}
