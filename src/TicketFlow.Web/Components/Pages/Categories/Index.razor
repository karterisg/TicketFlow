@page "/categories"
@using MudBlazor
@using TicketFlow.Shared.DTOs
@using TicketFlow.Web.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Categories - Desk</PageTitle>

<div class="page-header">
    <div><h1>Categories</h1><p>@_totalCount categories configured</p></div>
    <button class="btn btn-primary" @onclick="() => _showAdd = true">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add
    </button>
</div>

<div class="filter-bar">
    <input class="search-input" type="text" placeholder="Search categories…"
           value="@_search" @oninput="OnSearchInput" />
</div>

<div class="card" style="overflow:hidden;">
    <MudDataGrid @ref="_grid" T="CategoryDto" ServerData="ServerReload" Loading="_loading"
                 Hover="true" Dense="true" RowsPerPage="15" Height="calc(79vh - 260px)" FixedHeader="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.TicketCount" Title="Tickets">
                <CellTemplate>
                    <span class="text-2 mono">@context.Item.TicketCount</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Id" Title="">
                <CellTemplate>
                    <div style="text-align:right;">
                        <button class="btn btn-ghost btn-sm" @onclick="() => OpenEdit(context.Item)">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(context.Item)">Remove</button>
                    </div>
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <NoRecordsContent>
            <div class="empty-state">
                <p>No categories match your search.</p>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="CategoryDto" />
        </PagerContent>
    </MudDataGrid>
</div>

@if (_showAdd)
{
    <div class="dialog-overlay" @onclick="() => _showAdd = false">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <div class="dialog-title">New category</div>
            <div class="field">
                <label>Name</label>
                <input class="input" type="text" @bind="_newName" placeholder="e.g. Billing" />
            </div>
            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="() => _showAdd = false">Cancel</button>
                <button class="btn btn-primary" @onclick="Add" disabled="@_busy">Add</button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="dialog-overlay" @onclick="() => _editing = null">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <div class="dialog-title">Rename category</div>
            <div class="field">
                <label>Name</label>
                <input class="input" type="text" @bind="_editName" placeholder="e.g. Billing" />
            </div>
            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveEdit" disabled="@_busy">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private MudDataGrid<CategoryDto> _grid = default!;
    private bool _loading = true, _showAdd, _busy;
    private string _newName = "";
    private string _search = "";
    private int _totalCount;
    private CancellationTokenSource? _debounceCts;

    private CategoryDto? _editing;
    private string _editName = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthService.IsAuthenticated || !(AuthService.IsManager || AuthService.HasPermission("Categories.Manage"))) { Navigation.NavigateTo("/"); return; }
        await _grid.ReloadServerData();
    }

    private async Task<GridData<CategoryDto>> ServerReload(GridState<CategoryDto> state)
    {
        var result = await ApiService.GetCategoriesPagedAsync(state.Page + 1, state.PageSize, _search);
        _loading = false;
        _totalCount = result?.TotalCount ?? 0;
        return new GridData<CategoryDto> { TotalItems = result?.TotalCount ?? 0, Items = result?.Items ?? [] };
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _ = DebounceReload(token);
    }

    private async Task DebounceReload(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            _grid.NavigateTo(Page.First);
        }
        catch (TaskCanceledException) { }
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        _busy = true;
        var r = await ApiService.CreateCategoryAsync(_newName);
        _busy = false;
        if (r is not null) { _showAdd = false; _newName = ""; Snackbar.Add("Added.", Severity.Success); await _grid.ReloadServerData(); }
        else Snackbar.Add("Failed.", Severity.Error);
    }

    private void OpenEdit(CategoryDto c)
    {
        _editing = c;
        _editName = c.Name;
    }

    private async Task SaveEdit()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editName)) return;
        _busy = true;
        var ok = await ApiService.UpdateCategoryAsync(_editing.Id, _editName);
        _busy = false;
        if (ok)
        {
            _editing = null;
            Snackbar.Add("Category renamed.", Severity.Success);
            await _grid.ReloadServerData();
        }
        else Snackbar.Add("Failed to rename category.", Severity.Error);
    }

    private async Task Delete(CategoryDto c)
    {
        var ok = await ApiService.DeleteCategoryAsync(c.Id);
        if (ok) { Snackbar.Add("Removed.", Severity.Success); await _grid.ReloadServerData(); }
        else Snackbar.Add("Cannot remove category: it has tickets.", Severity.Error);
    }
}
