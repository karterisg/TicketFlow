@page "/register"
@using MudBlazor
@using TicketFlow.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Register - Desk</PageTitle>

<div class="auth-wrap">
    <div class="auth-box">
        <div class="auth-logo">Ticket<span>Flow</span></div>
        <div class="auth-title">Create account</div>
        <div class="auth-sub">Fill in your details to get started</div>

        <div class="field">
            <label>Full name</label>
            <MudTextField @bind-Value="_name" Variant="Variant.Outlined" FullWidth="true" Placeholder="Giorgos Kart" />
        </div>
        <div class="field">
            <label>Email</label>
            <MudTextField @bind-Value="_email" Variant="Variant.Outlined" InputType="InputType.Email"
                          FullWidth="true" Placeholder="you@example.com" />
        </div>
        <div class="field">
            <label>Password</label>
            <MudTextField @bind-Value="_password" Variant="Variant.Outlined"
                          InputType="@(_show ? InputType.Text : InputType.Password)"
                          FullWidth="true" Placeholder="••••••••"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _show = !_show" />
        </div>
        <div class="field">
            <label>Role</label>
            <MudSelect @bind-Value="_role" Variant="Variant.Outlined" FullWidth="true">
                <MudSelectItem Value="@("Customer")">Customer</MudSelectItem>
                <MudSelectItem Value="@("Agent")">Agent</MudSelectItem>
                <MudSelectItem Value="@("Manager")">Manager</MudSelectItem>
            </MudSelect>
        </div>

        <button class="btn btn-primary" style="width:100%; justify-content:center; padding:10px;"
                @onclick="HandleRegister" disabled="@_loading">
            @(_loading ? "Creating account…" : "Create account")
        </button>

        <p style="text-align:center; margin-top:18px; font-size:12.5px; color:var(--text-2);">
            Already registered? <a href="/login" style="color:var(--accent-text); text-decoration:none;">Sign in</a>
        </p>
    </div>
</div>

@code {
    private string _name = "", _email = "", _password = "", _role = "Customer";
    private bool _show, _loading;

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated) Navigation.NavigateTo("/");
    }


    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Fill in all fields.", Severity.Warning);
            return;
        }

        if (!_email.Contains('@') || !_email.Contains('.'))
        {
            Snackbar.Add("Please enter a valid email address.", Severity.Warning);
            return;
        }

        if (_password.Length <= 6)
        {
            Snackbar.Add("Please enter a valid password.", Severity.Warning);
        }

        _loading = true;
        var result = await AuthService.RegisterAsync(_name, _email, _password, _role, JS);
        _loading = false;

        if (result.Success)
            Navigation.NavigateTo("/");
        else
            Snackbar.Add(result.Error ?? "Registration failed.", Severity.Error);
    }
}


