@page "/permissions"
@using MudBlazor
@using TicketFlow.Shared.DTOs
@using TicketFlow.Web.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Permissions | Desk</PageTitle>

<div class="page-header">
    <div><h1>Permissions</h1><p>Control what each user can see and do</p></div>
</div>

<div class="filter-bar">
    <input class="search-input" type="text" placeholder="Search users…"
           value="@_search" @oninput="OnSearchInput" />
</div>

<div class="card" style="overflow:hidden;">
    <MudDataGrid @ref="_grid" T="UserDto" ServerData="ServerReload" Loading="_loading"
                 Hover="true" Dense="true" RowsPerPage="15" Height="calc(79vh - 260px)" FixedHeader="true">
        <Columns>
            <PropertyColumn Property="x => x.FullName" Title="Name">
                <CellTemplate>
                    <span style="font-weight:500;">@context.Item.FullName</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Email" Title="Email">
                <CellTemplate>
                    <span class="text-2">@context.Item.Email</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Role" Title="Role">
                <CellTemplate>
                    <span class="text-2">@context.Item.Role</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Id" Title="">
                <CellTemplate>
                    <div style="text-align:right;">
                        <button class="btn btn-ghost" style="font-size:0.78rem; padding:4px 10px;"
                                disabled="@(string.IsNullOrEmpty(context.Item.AppUserId))"
                                @onclick="() => OpenEdit(context.Item)">
                            Manage access
                        </button>
                    </div>
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <NoRecordsContent>
            <div class="empty-state">
                <p>No users match your search.</p>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="UserDto" />
        </PagerContent>
    </MudDataGrid>
</div>

@if (_editUser is not null)
{
    <div class="dialog-overlay" @onclick="CloseEdit">
        <div class="dialog-box" @onclick:stopPropagation="true" style="max-width:520px;">
            <div class="dialog-title">Access for @_editUser.FullName</div>
            <p style="margin:0 0 16px; color:var(--text-2); font-size:0.9rem;">
                Choose exactly what this user is allowed to see and do beyond their default role.
            </p>

            @if (_editLoading)
            {
                <p class="text-2">Loading…</p>
            }
            else
            {
                @foreach (var category in _allPermissions.GroupBy(p => p.Category))
                {
                    <div style="margin-bottom:14px;">
                        <div style="font-weight:600; font-size:0.85rem; margin-bottom:6px;">@category.Key</div>
                        @foreach (var permission in category)
                        {
                            <label style="display:flex; align-items:center; gap:8px; padding:4px 0; font-size:0.88rem; cursor:pointer;">
                                <input type="checkbox" checked="@_grantedKeys.Contains(permission.Key)"
                                       @onchange="e => Toggle(permission.Key, (bool)(e.Value ?? false))" />
                                <span>@permission.Description</span>
                            </label>
                        }
                    </div>
                }
            }

            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="CloseEdit">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveEdit" disabled="@(_busy || _editLoading)">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private MudDataGrid<UserDto> _grid = default!;
    private bool _loading = true, _busy, _editLoading;
    private string _search = "";
    private CancellationTokenSource? _debounceCts;

    private List<PermissionDto> _allPermissions = new();
    private UserDto? _editUser;
    private HashSet<string> _grantedKeys = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthService.IsAuthenticated || !AuthService.IsManager) { Navigation.NavigateTo("/"); return; }
        _allPermissions = await ApiService.GetAllPermissionsAsync();
        await _grid.ReloadServerData();
    }

    private async Task<GridData<UserDto>> ServerReload(GridState<UserDto> state)
    {
        var result = await ApiService.GetUsersPagedAsync(state.Page + 1, state.PageSize, _search);
        _loading = false;
        return new GridData<UserDto> { TotalItems = result?.TotalCount ?? 0, Items = result?.Items ?? [] };
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _ = DebounceReload(token);
    }

    private async Task DebounceReload(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            _grid.NavigateTo(Page.First);
        }
        catch (TaskCanceledException) { }
    }

    private async Task OpenEdit(UserDto u)
    {
        if (string.IsNullOrEmpty(u.AppUserId)) return;
        _editUser = u;
        _editLoading = true;
        var keys = await ApiService.GetUserPermissionsAsync(u.AppUserId);
        _grantedKeys = new HashSet<string>(keys);
        _editLoading = false;
    }

    private void CloseEdit()
    {
        _editUser = null;
        _grantedKeys = new();
    }

    private void Toggle(string key, bool granted)
    {
        if (granted) _grantedKeys.Add(key);
        else _grantedKeys.Remove(key);
    }

    private async Task SaveEdit()
    {
        if (_editUser is null || string.IsNullOrEmpty(_editUser.AppUserId)) return;
        _busy = true;
        var ok = await ApiService.UpdateUserPermissionsAsync(_editUser.AppUserId, _grantedKeys.ToList());
        _busy = false;
        if (ok)
        {
            Snackbar.Add("Access updated.", Severity.Success);
            CloseEdit();
        }
        else
        {
            Snackbar.Add("Failed to update access.", Severity.Error);
        }
    }
}
