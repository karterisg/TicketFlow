@page "/project-categories"
@using MudBlazor
@using TicketFlow.Shared.DTOs
@using TicketFlow.Web.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Project Categories — Desk</PageTitle>

<div style="margin-bottom:20px;">
    <a href="/projects" class="btn btn-ghost btn-sm">← Back to Projects</a>
</div>

<div class="page-header">
    <div><h1>Project Categories</h1><p>@_totalCount categories configured</p></div>
    <button class="btn btn-primary" @onclick="() => _showAdd = true">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add
    </button>
</div>

<div class="filter-bar">
    <input class="search-input" type="text" placeholder="Search categories…"
           value="@_search" @oninput="OnSearchInput" />
</div>

<div class="card" style="overflow:hidden;">
    <MudDataGrid @ref="_grid" T="ProjectCategoryDto" ServerData="ServerReload" Loading="_loading"
                 Hover="true" Dense="true" RowsPerPage="15" Height="calc(79vh - 260px)" FixedHeader="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name">
                <CellTemplate>
                    @if (_editingId == context.Item.Id)
                    {
                        <input class="input" @bind="_editName" />
                    }
                    else
                    {
                        @context.Item.Name
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.ProjectCount" Title="Projects">
                <CellTemplate>
                    <span class="text-2 mono">@context.Item.ProjectCount</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Id" Title="">
                <CellTemplate>
                    <div style="text-align:right;">
                        @if (_editingId == context.Item.Id)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => SaveEdit(context.Item)">Save</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => _editingId = null">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-ghost btn-sm" @onclick="() => StartEdit(context.Item)">Rename</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => Delete(context.Item)">Remove</button>
                        }
                    </div>
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <NoRecordsContent>
            <div class="empty-state">
                <p>No project categories match your search.</p>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="ProjectCategoryDto" />
        </PagerContent>
    </MudDataGrid>
</div>

@if (_showAdd)
{
    <div class="dialog-overlay" @onclick="() => _showAdd = false">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <div class="dialog-title">New project category</div>
            <div class="field">
                <label>Name</label>
                <input class="input" type="text" @bind="_newName" placeholder="e.g. Internal" />
            </div>
            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="() => _showAdd = false">Cancel</button>
                <button class="btn btn-primary" @onclick="Add" disabled="@_busy">Add</button>
            </div>
        </div>
    </div>
}

@code {
    private MudDataGrid<ProjectCategoryDto> _grid = default!;
    private bool _loading = true, _showAdd, _busy;
    private string _newName = "";
    private int? _editingId;
    private string _editName = "";
    private string _search = "";
    private int _totalCount;
    private CancellationTokenSource? _debounceCts;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _ = DebounceReload(token);
    }

    private async Task DebounceReload(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            _grid.NavigateTo(Page.First);
        }
        catch (TaskCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthService.IsAuthenticated || !(AuthService.IsManager || AuthService.HasPermission("ProjectCategories.Manage"))) { Navigation.NavigateTo("/"); return; }
        await _grid.ReloadServerData();
    }

    private async Task<GridData<ProjectCategoryDto>> ServerReload(GridState<ProjectCategoryDto> state)
    {
        var result = await ApiService.GetProjectCategoriesPagedAsync(state.Page + 1, state.PageSize, _search);
        _loading = false;
        _totalCount = result?.TotalCount ?? 0;
        return new GridData<ProjectCategoryDto> { TotalItems = result?.TotalCount ?? 0, Items = result?.Items ?? [] };
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        _busy = true;
        var r = await ApiService.CreateProjectCategoryAsync(_newName);
        _busy = false;
        if (r is not null) { _showAdd = false; _newName = ""; Snackbar.Add("Added.", Severity.Success); await _grid.ReloadServerData(); }
        else Snackbar.Add("Failed.", Severity.Error);
    }

    private void StartEdit(ProjectCategoryDto c)
    {
        _editingId = c.Id;
        _editName = c.Name;
    }

    private async Task SaveEdit(ProjectCategoryDto c)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        var ok = await ApiService.UpdateProjectCategoryAsync(c.Id, _editName);
        if (ok) { _editingId = null; Snackbar.Add("Updated.", Severity.Success); await _grid.ReloadServerData(); }
        else Snackbar.Add("Failed to update.", Severity.Error);
    }

    private async Task Delete(ProjectCategoryDto c)
    {
        var ok = await ApiService.DeleteProjectCategoryAsync(c.Id);
        if (ok) { Snackbar.Add("Removed.", Severity.Success); await _grid.ReloadServerData(); }
        else Snackbar.Add("Cannot remove — category has projects.", Severity.Error);
    }
}
