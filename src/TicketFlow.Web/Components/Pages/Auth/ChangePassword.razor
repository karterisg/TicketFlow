@page "/change-password"
@using MudBlazor
@using TicketFlow.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Change password - Desk</PageTitle>

<div class="auth-wrap">
    <div class="auth-box">
        <div class="auth-logo">Ticket<span>Flow</span></div>
        <div class="auth-title">Change password</div>
        <div class="auth-sub">Update your account password</div>

        <div class="field">
            <label>Current password</label>
            <MudTextField @bind-Value="_currentPassword" Variant="Variant.Outlined"
                          InputType="InputType.Password" FullWidth="true" Placeholder="••••••••" />
        </div>

        <div class="field">
            <label>New password</label>
            <MudTextField @bind-Value="_newPassword" Variant="Variant.Outlined"
                          InputType="InputType.Password" FullWidth="true" Placeholder="••••••••" />
        </div>

        <div class="field">
            <label>Confirm new password</label>
            <MudTextField @bind-Value="_confirmPassword" Variant="Variant.Outlined"
                          InputType="InputType.Password" FullWidth="true" Placeholder="••••••••" />
        </div>

        <button class="btn btn-primary" style="width:100%; justify-content:center; padding:10px;"
                @onclick="HandleChangePassword" disabled="@_loading">
            @if (_loading) { <span>Saving…</span> } else { <span>Change password</span> }
        </button>

        <p style="text-align:center; margin-top:18px; font-size:12.5px; color:var(--text-2);">
            <a href="/" style="color:var(--accent-text); text-decoration:none;">Back to dashboard</a>
        </p>
    </div>
</div>

@code {
    private string _currentPassword = "", _newPassword = "", _confirmPassword = "";
    private bool _loading;

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated) Navigation.NavigateTo("/login");
    }

    private async Task HandleChangePassword()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        { Snackbar.Add("Fill in all fields.", Severity.Warning); return; }

        if (_newPassword != _confirmPassword)
        { Snackbar.Add("New password and confirmation do not match.", Severity.Warning); return; }

        _loading = true;
        var (success, error) = await AuthService.ChangePasswordAsync(_currentPassword, _newPassword);
        _loading = false;

        if (success)
        {
            Snackbar.Add("Password changed successfully.", Severity.Success);
            _currentPassword = _newPassword = _confirmPassword = "";
        }
        else
        {
            Snackbar.Add(error ?? "Failed to change password.", Severity.Error);
        }
    }
}
