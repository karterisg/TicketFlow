@page "/project-templates"
@using MudBlazor
@using TicketFlow.Shared.DTOs
@using TicketFlow.Web.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Project Templates — Desk</PageTitle>

<div style="margin-bottom:20px;">
    <a href="/projects" class="btn btn-ghost btn-sm">← Back to Projects</a>
</div>

<div class="page-header">
    <div><h1>Project Templates</h1><p>@_totalCount templates configured</p></div>
    <button class="btn btn-primary" @onclick="() => _showAdd = true">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New template
    </button>
</div>

<div class="filter-bar">
    <input class="search-input" type="text" placeholder="Search templates…"
           value="@_search" @oninput="OnSearchInput" />
</div>

<div class="card" style="overflow:hidden;">
    <MudDataGrid @ref="_grid" T="ProjectTemplateDto" ServerData="ServerReload" Loading="_loading"
                 Hover="true" Dense="true" RowsPerPage="15" Height="calc(79vh - 260px)" FixedHeader="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.DefaultProjectCategoryId" Title="Category">
                <CellTemplate>
                    <span class="text-2">@(_categories.FirstOrDefault(c => c.Id == context.Item.DefaultProjectCategoryId)?.Name ?? "—")</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.DefaultIconKey" Title="Icon">
                <CellTemplate>
                    <span class="text-2">@context.Item.DefaultIconKey</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Id" Title="">
                <CellTemplate>
                    <div style="text-align:right;">
                        <button class="btn btn-ghost btn-sm" @onclick="() => OpenEdit(context.Item)">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(context.Item)">Remove</button>
                    </div>
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <NoRecordsContent>
            <div class="empty-state">
                <p>No templates match your search.</p>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="ProjectTemplateDto" />
        </PagerContent>
    </MudDataGrid>
</div>

@if (_showAdd)
{
    <div class="dialog-overlay" @onclick="() => _showAdd = false">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <div class="dialog-title">New template</div>
            <div class="field">
                <label>Name</label>
                <input class="input" type="text" @bind="_newName" placeholder="e.g. Client Onboarding" />
            </div>
            <div class="field">
                <label>Description</label>
                <input class="input" type="text" @bind="_newDescription" placeholder="Optional" />
            </div>
            <div class="field">
                <label>Default category</label>
                <select class="input" @bind="_newCategoryId">
                    <option value="">— none —</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="() => _showAdd = false">Cancel</button>
                <button class="btn btn-primary" @onclick="Add" disabled="@_busy">Add</button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="dialog-overlay" @onclick="() => _editing = null">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <div class="dialog-title">Edit template</div>
            <div class="field">
                <label>Name</label>
                <input class="input" type="text" @bind="_editName" placeholder="e.g. Client Onboarding" />
            </div>
            <div class="field">
                <label>Description</label>
                <input class="input" type="text" @bind="_editDescription" placeholder="Optional" />
            </div>
            <div class="field">
                <label>Default category</label>
                <select class="input" @bind="_editCategoryId">
                    <option value="">— none —</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Default icon key</label>
                <input class="input" type="text" @bind="_editIconKey" placeholder="folder" />
            </div>
            <div class="field">
                <label><input type="checkbox" @bind="_editAllowCustomerTicketCreation" /> Allow customer ticket creation</label>
            </div>
            <div class="field">
                <label><input type="checkbox" @bind="_editRequireApprovalForClose" /> Require approval for close</label>
            </div>
            <div class="dialog-actions">
                <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveEdit" disabled="@_busy">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private MudDataGrid<ProjectTemplateDto> _grid = default!;
    private List<ProjectCategoryDto> _categories = [];
    private bool _loading = true, _showAdd, _busy;
    private string _newName = "", _newDescription = "", _newCategoryId = "";
    private string _search = "";
    private int _totalCount;
    private CancellationTokenSource? _debounceCts;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _ = DebounceReload(token);
    }

    private async Task DebounceReload(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            _grid.NavigateTo(Page.First);
        }
        catch (TaskCanceledException) { }
    }

    private ProjectTemplateDto? _editing;
    private string _editName = "", _editDescription = "", _editCategoryId = "", _editIconKey = "";
    private bool _editAllowCustomerTicketCreation, _editRequireApprovalForClose;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthService.IsAuthenticated || !(AuthService.IsManager || AuthService.HasPermission("ProjectTemplates.Manage"))) { Navigation.NavigateTo("/"); return; }
        _categories = await ApiService.GetProjectCategoriesAsync();
        await _grid.ReloadServerData();
    }

    private async Task<GridData<ProjectTemplateDto>> ServerReload(GridState<ProjectTemplateDto> state)
    {
        var result = await ApiService.GetProjectTemplatesPagedAsync(state.Page + 1, state.PageSize, _search);
        _loading = false;
        _totalCount = result?.TotalCount ?? 0;
        return new GridData<ProjectTemplateDto> { TotalItems = result?.TotalCount ?? 0, Items = result?.Items ?? [] };
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        _busy = true;
        var r = await ApiService.CreateProjectTemplateAsync(new CreateProjectTemplateDto
        {
            Name = _newName,
            Description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription,
            DefaultProjectCategoryId = int.TryParse(_newCategoryId, out var catId) ? catId : null
        });
        _busy = false;
        if (r is not null)
        {
            _showAdd = false;
            _newName = ""; _newDescription = ""; _newCategoryId = "";
            Snackbar.Add("Template created.", Severity.Success);
            await _grid.ReloadServerData();
        }
        else Snackbar.Add("Failed to create template.", Severity.Error);
    }

    private void OpenEdit(ProjectTemplateDto t)
    {
        _editing = t;
        _editName = t.Name;
        _editDescription = t.Description ?? "";
        _editCategoryId = t.DefaultProjectCategoryId?.ToString() ?? "";
        _editIconKey = t.DefaultIconKey;
        _editAllowCustomerTicketCreation = t.DefaultAllowCustomerTicketCreation;
        _editRequireApprovalForClose = t.DefaultRequireApprovalForClose;
    }

    private async Task SaveEdit()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editName)) return;
        _busy = true;
        var dto = new UpdateProjectTemplateDto
        {
            Name = _editName,
            Description = string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription,
            DefaultProjectCategoryId = int.TryParse(_editCategoryId, out var catId) ? catId : null,
            DefaultIconKey = string.IsNullOrWhiteSpace(_editIconKey) ? "folder" : _editIconKey,
            DefaultAllowCustomerTicketCreation = _editAllowCustomerTicketCreation,
            DefaultRequireApprovalForClose = _editRequireApprovalForClose,
            Timeline = _editing.Timeline
        };
        var ok = await ApiService.UpdateProjectTemplateAsync(_editing.Id, dto);
        _busy = false;
        if (ok)
        {
            _editing = null;
            Snackbar.Add("Template updated.", Severity.Success);
            await _grid.ReloadServerData();
        }
        else Snackbar.Add("Failed to update template.", Severity.Error);
    }

    private async Task Delete(ProjectTemplateDto t)
    {
        var ok = await ApiService.DeleteProjectTemplateAsync(t.Id);
        if (ok) { Snackbar.Add("Removed.", Severity.Success); await _grid.ReloadServerData(); }
        else Snackbar.Add("Failed to remove.", Severity.Error);
    }
}
